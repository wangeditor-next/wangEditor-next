{
  "name": "@wangeditor-next/yjs-for-react",
  "version": "6.4.2",
  "description": "React specific components/utils for wangeditor-next-yjs.",
  "author": "cycleccc <2991205548@qq.com>",
  "type": "module",
  "homepage": "https://github.com/wangeditor-next/wangEditor-next#readme",
  "license": "MIT",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.js",
  "keywords": [
    "slate",
    "wangEditor-next",
    "yjs",
    "collaborative",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "lib": "dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangeditor-next/wangEditor-next.git"
  },
  "scripts": {
    "test": "vitest run",
    "test-c": "vitest run --coverage",
    "dev": "cross-env NODE_ENV=development tsdown -c tsdown.config.js",
    "dev-watch": "cross-env NODE_ENV=development tsdown -c tsdown.config.js -w",
    "build": "cross-env NODE_ENV=production tsdown -c tsdown.config.js",
    "dev-size-stats": "cross-env NODE_ENV=development:size_stats tsdown -c tsdown.config.js --report",
    "size-stats": "cross-env NODE_ENV=production:size_stats tsdown -c tsdown.config.js --report"
  },
  "devDependencies": {
    "@types/use-sync-external-store": "^0.0.6"
  },
  "bugs": {
    "url": "https://github.com/wangeditor-next/wangEditor-next/issues"
  },
  "dependencies": {
    "use-sync-external-store": "^1.2.0",
    "y-protocols": "^1.0.5"
  },
  "peerDependencies": {
    "@wangeditor-next/editor": "workspace:^",
    "@wangeditor-next/yjs": "workspace:^",
    "react": ">=17.0.2",
    "slate": "^0.124.0",
    "yjs": "^13.5.29"
  }
}
