    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@wangeditor-next/editor": "workspace:^",
    "vue": "^3.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitejs/plugin-vue": "^5.2.4",
