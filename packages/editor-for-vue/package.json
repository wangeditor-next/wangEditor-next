  "types": "dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "wangEditor",
    "wangEditor-next",
    "rich text editor",
    "vue3"
  ],
  "exports": {
