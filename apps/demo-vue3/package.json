{
  "name": "@wangeditor-next/demo-vue3",
  "private": true,
  "version": "0.0.26",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "dev:all": "pnpm exec concurrently \"pnpm --dir ../../packages/editor dev-watch\" \"pnpm --dir ../../packages/editor-for-vue dev-watch\" \"pnpm run dev\"",
    "build": "vite build",
    "smoke": "pnpm --dir ../.. exec turbo build --filter=@wangeditor-next/demo-vue3"
  },
  "dependencies": {
    "@wangeditor-next/editor": "workspace:*",
    "@wangeditor-next/editor-for-vue": "workspace:*",
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "5.2.2",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.12"
  }
}
