{
  "name": "@wangeditor-next/demo-yjs-vue3",
  "private": true,
  "version": "0.0.27",
  "type": "module",
  "scripts": {
    "dev-client": "vite --force",
    "dev": "pnpm run dev-client",
    "dev-server": "pnpm --filter @wangeditor-next/demo-yjs-server dev",
    "dev:all": "pnpm exec concurrently \"pnpm --dir ../../packages/editor dev-watch\" \"pnpm --dir ../../packages/yjs dev-watch\" \"pnpm --dir ../../packages/yjs-for-vue dev-watch\" \"pnpm run dev-server\" \"pnpm run dev-client\"",
    "build": "vite build",
    "smoke": "pnpm --dir ../.. exec turbo build --filter=@wangeditor-next/demo-yjs-vue3",
    "eslint-fix": "pnpm exec eslint --fix src/   "
  },
  "dependencies": {
    "@faker-js/faker": "^7.5.0",
    "@fortawesome/fontawesome-svg-core": "^6.1.0",
    "@fortawesome/free-regular-svg-icons": "^6.0.0",
    "@fortawesome/free-solid-svg-icons": "^6.0.0",
    "@fortawesome/vue-fontawesome": "^3.0.0",
    "@wangeditor-next/editor": "workspace:*",
    "@wangeditor-next/editor-for-vue": "workspace:*",
    "@wangeditor-next/yjs": "workspace:*",
    "@wangeditor-next/yjs-for-vue": "workspace:*",
    "randomcolor": "^0.6.2",
    "vue": "^3.5.43",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/randomcolor": "^0.5.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11",
    "y-websocket": "2.0.4",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "vite-plugin-windicss": "^1.9.4",
    "windicss": "^3.5.6"
  }
}
